# ===== App =====
APP_PORT=8444
APP_SECRET=                       # required: openssl rand -hex 32   (or APP_SECRET_FILE=/app/secrets/app_secret)
APP_BASE_URL=https://mamorai.example.internal:8444
APP_LOCALE=ja                     # ja | en
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=               # used only on first start
APP_ADMIN_MUST_CHANGE=true        # true: the first admin must change the password at first login (false when it was chosen in the installer)
TLS_CERT_FILE=                    # blank = self-signed certificate generated in /app/data/tls
TLS_KEY_FILE=
TLS_DISABLED=false
TRUST_PROXY=false
LOG_LEVEL=info

# ===== DB =====
DB_DRIVER=sqlite                  # sqlite | postgres
DB_PATH=/app/data/edr-console.db
DATABASE_URL=

# ===== Wazuh (first-start bootstrap; afterwards managed in Settings) =====
WAZUH_NAME=wazuh-manager
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=edr-console-ro
WAZUH_INDEXER_PASSWORD=
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=edr-console-ro
WAZUH_API_PASSWORD=
WAZUH_CA_FILE=/app/secrets/wazuh-root-ca.pem
WAZUH_TLS_VERIFY=true
WAZUH_API_TLS_VERIFY=false      # Wazuh API ships a self-signed cert (CN=wazuh.com); set true only after replacing it

# ===== LLM =====
LLM_PROVIDER=openrouter           # openrouter | ollama | anthropic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-pro
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS_PER_SESSION=1500000   # cumulative input+output across all turns of one session (each turn re-sends the context)
LLM_MAX_SESSIONS_PER_HOUR=20
LLM_REDACT_INTERNAL_IPS=false

# ===== Integrations (optional) =====
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=EDR
DISCORD_WEBHOOK_URL=

# ===== Sentinel =====
SENTINEL_ENABLED=false
SENTINEL_POLL_SEC=30
SENTINEL_MIN_LEVEL=12

# ===== Autonomy =====
AUTONOMY_DEFAULT=1
AUTONOMY_MAX=2

# --- EDR-90: sign-in protection (secure defaults; uncomment only to weaken on purpose) ---
# MFA_REQUIRED=true                # TOTP (authenticator app via QR code) for every user, no e-mail / SMS / external service
# MFA_MAX_FAILS=5                  # wrong 6-digit codes before a 15-minute lock
# LOGIN_MAX_FAILS_PER_ACCOUNT=5    # wrong passwords per account within LOGIN_FAIL_WINDOW_MIN
# LOGIN_MAX_FAILS_PER_IP=20
# LOGIN_FAIL_WINDOW_MIN=15
# LOGIN_LOCK_MIN=15
# API_TOKEN_MAX_DAYS=365
# API_TOKEN_REQUIRE_IP=true        # new API tokens must name the source IPs / CIDRs they may be used from
# AUTO_HOLD_MAX_CHANGES_10MIN=15   # kill switch trips when more changes run within 10 minutes (0 = off)
# WAZUH_DASHBOARD_PROXY=true       # /wazuh → Wazuh dashboard through MamorAI (installer/modules/30-*)
# WAZUH_DASHBOARD_URL=https://127.0.0.1:8443
# WAZUH_DASHBOARD_BASEPATH=/wazuh

# --- EDR-121: host AI scan (ホストカルテ) and host actions ---
# HOST_AGENT_SYNC_MIN=10           # import Wazuh agents as "agent only" hosts every N minutes (0 = off)
# HOST_SCAN_CONCURRENCY=2
# HOST_SCAN_AI=true                # false = show collected facts only, never call the LLM for host scans
# HOST_SCAN_MAX_TOKENS=60000       # per scan; above this the AI interpretation is skipped
# HOST_ACTION_LINUX_AUTOREVERT_SEC=180   # Linux network actions revert themselves unless MamorAI can still log in
# HOST_ACTION_ISOLATION_REMIND_HOURS=24  # "still isolated" reminder (isolation is never released automatically)
# Windows endpoints: a Wazuh API user that may ONLY run active responses (installer/modules/50-wazuh-ar-user.sh creates it)
# WAZUH_AR_USER=mamorai-ar
# WAZUH_AR_PASSWORD=               # or WAZUH_AR_PASSWORD_FILE=/run/secrets/...
# AR_ADDON_MIN_VERSION=1.0.0       # endpoints with an older add-on cannot receive actions
